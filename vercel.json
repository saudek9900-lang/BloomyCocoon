{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/collection",
      "destination": "/collections",
      "permanent": true
    },
    {
      "source": "/custom",
      "destination": "/custom-order",
      "permanent": true
    },
    {
      "source": "/custom-orders",
      "destination": "/custom-order",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/collections",
      "destination": "/collections/index.html"
    },
    {
      "source": "/custom-order",
      "destination": "/custom-order/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    }
  ]
}
